# Порт сайта на VPS. Для обычного HTTP оставьте 80.
APP_PORT=80

# PostgreSQL. Обязательно поменять пароль перед запуском на сервере.
POSTGRES_DB=sanmedexpress
POSTGRES_USER=sanmedexpress
POSTGRES_PASSWORD=change-me-db-password

# Простая админка: http://SERVER_IP/admin/
# Обязательно поменять пароль перед показом заказчику.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Email для уведомлений о новых заявках.
# Пока можно оставить EMAIL_ENABLED=false, пока нет SMTP-почты.
EMAIL_ENABLED=false
EMAIL_TO=sergeevsci@yandex.ru
EMAIL_FROM=no-reply@sanmedexpress.local

# SMTP-почта отправителя. Здесь поменять, когда будет реальная почта.
# Например, для Яндекс 360/почты на домене обычно: smtp.yandex.ru, порт 465 или 587.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=site@example.com
MAIL_PASSWORD=change-me-mail-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
